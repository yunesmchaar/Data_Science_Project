        "from pycoingecko import CoinGeckoAPI\n",
        "cg = CoinGeckoAPI()\n",
        "bitcoin_data = cg.get_coin_market_chart_by_id(id = 'bitcoin',vs_currency = 'usd', days=30)"
      ],
      "metadata": {
        "id": "7AYvppEmiAYC"
      },
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "data = pd.DataFrame(bitcoin_data['prices'],columns=['TimeStamp','Price'])"
      ],
      "metadata": {
        "id": "pJy9JABcigT7"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "data['Data'] = pd.to_datetime(data['TimeStamp'],unit = 'ms')"
      ],
      "metadata": {
        "id": "v4QeIdm4k36W"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "candlestick_data = data.groupby(data.Data.dt.date).agg({'Price':['min','max','first','last']})"
      ],
      "metadata": {
        "id": "YonDdD4tlX56"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import plotly.graph_objects as go\n",
        "\n",
        "fig = go.Figure(data=[go.Candlestick(x = candlestick_data.index,\n",
        "                                     open = candlestick_data['Price']['first'],\n",
        "                                     high = candlestick_data['Price']['max'],\n",
        "                                     low = candlestick_data['Price']['min'],\n",
        "                                     close = candlestick_data['Price']['last'])])\n",
        "\n",
        "fig.update_layout(\n",
        "    xaxis_rangeslider_visible = False,\n",
        "    yaxis_title = 'Price(USD $)',\n",
        "    title='Bitcoin Candlestick Chart Over Past 30 Days'\n",
        ")\n",
        "fig.show()"
      ],
